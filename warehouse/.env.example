# Variables que necesita el pipeline. En la EC2 este archivo (docker/.env) lo genera el user data
# leyendo SSM Parameter Store; NO se sube a git. Aquí sólo hay valores de ejemplo.
DW_BUCKET=tallerdw-123456789012-abc123
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# RDS for MySQL
MYSQL_HOST=tallerdw-mysql.xxxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=dwadmin
MYSQL_PASSWORD=<desde SSM /tallerdw/mysql_password>
MYSQL_DATABASE=ecommerce

# DocumentDB (TLS obligatorio, retryWrites=false)
MONGODB_URI=mongodb://dwadmin:<desde SSM /tallerdw/docdb_password>@tallerdw-docdb.cluster-xxxx.us-east-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=/opt/certs/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DATABASE=ecommerce

# Redshift Serverless
REDSHIFT_HOST=tallerdw-wg.123456789012.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=dwadmin
REDSHIFT_PASSWORD=<desde SSM /tallerdw/redshift_password>
REDSHIFT_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/tallerdw-redshift-s3-role
QUICKSIGHT_RO_PASSWORD=<desde SSM /tallerdw/quicksight_password>
WAREHOUSE_ENGINE=redshift
DBT_TARGET=redshift

# QuickSight (vacío = Direct Query o refresco manual)
QUICKSIGHT_DATASET_ID=
# Programación del DAG (vacío = sólo manual). Ej: 0 6 * * *
DW_SCHEDULE=

# Airflow
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<desde SSM /tallerdw/airflow_admin_password>
POSTGRES_PASSWORD=<aleatoria>
AIRFLOW_FERNET_KEY=<aleatoria>
AIRFLOW_WEBSERVER_SECRET_KEY=<aleatoria>
